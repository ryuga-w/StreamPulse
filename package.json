{
  "name": "streampulse-downloader",
  "version": "1.0.0",
  "description": "Ultra Fast, High-Performance YouTube MP3 & 4K Video Downloader Desktop App",
  "main": "electron/main.js",
  "author": "Yüksel Bilgin",
  "license": "MIT",
  "scripts": {
    "server": "node server.js",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "dev": "cross-env NODE_ENV=development concurrently -k \"node server.js\" \"npm run dev:renderer\" \"wait-on tcp:5173 && electron electron/main.js\"",
    "start": "electron electron/main.js",
    "dist": "npm run build:renderer && electron-builder --win nsis",
    "dist:portable": "npm run build:renderer && electron-builder --win portable",
    "dist:all": "npm run build:renderer && electron-builder --win nsis portable",
    "build": "npm run build:renderer && electron-builder"
  },
  "build": {
    "appId": "com.streampulse.downloader",
    "productName": "StreamPulse Downloader",
    "copyright": "Copyright © 2026 Yüksel Bilgin",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StreamPulse Downloader",
      "uninstallDisplayName": "StreamPulse Downloader",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
